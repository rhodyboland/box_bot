# Box Bot device permissions and stable names.
#
# Install on the Jetson host:
#   sudo cp 99-boxbot-devices.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Find USB serial attributes with:
#   udevadm info -a -n /dev/ttyACM0 | less
#   udevadm info -a -n /dev/ttyUSB0 | less

SUBSYSTEM=="i2c-dev", KERNEL=="i2c-[0-9]*", GROUP="i2c", MODE="0660"
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", GROUP="gpio", MODE="0660"
KERNEL=="gpiomem", GROUP="gpio", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyTHS[0-9]*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyUSB[0-9]*", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*", GROUP="dialout", MODE="0660"

# ZED-X20P main USB interfaces, identified by the configured USB serial strings.
# Confirmed physical positions: BOXBOT_BASE is front; BOXBOT_ROVER is back.
# Match receiver identity rather than USB port or enumeration order. Keep the
# role aliases used by ROS and add physical-position aliases for inspection.
# Prevent ModemManager from probing the GNSS receivers.
SUBSYSTEM=="usb", ATTR{idVendor}=="1546", ATTR{idProduct}=="01ab", GROUP="plugdev", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1546", ENV{ID_MODEL_ID}=="01ab", ENV{ID_SERIAL_SHORT}=="BOXBOT_BASE", SYMLINK+="boxbot/gps_moving_base", SYMLINK+="boxbot/gps_front", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1546", ENV{ID_MODEL_ID}=="01ab", ENV{ID_SERIAL_SHORT}=="BOXBOT_ROVER", SYMLINK+="boxbot/gps_rover", SYMLINK+="boxbot/gps_back", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0"
#
# Stable name for the SLLIDAR C1 USB adapter.
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="10c4", ENV{ID_MODEL_ID}=="ea60", ENV{ID_SERIAL_SHORT}=="f8027a42ffe5ed119038daa80b2af5ab", SYMLINK+="boxbot/lidar", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1", ENV{ID_MM_CANDIDATE}="0"

# Intel RealSense cameras expose video nodes plus raw USB interfaces. The ROS
# wrapper/librealsense needs access to both from inside the container.
SUBSYSTEM=="usb", ATTR{idVendor}=="8086", GROUP="video", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="8086", GROUP="video", MODE="0660", TAG+="uaccess"
