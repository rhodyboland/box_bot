ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-c"]

# Fix apt repo metadata/key issues inherited from base image
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://dl.yarnpkg.com/debian/pubkey.gpg \
      | gpg --dearmor -o /etc/apt/keyrings/yarn.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/yarn.gpg] https://dl.yarnpkg.com/debian stable main" \
      > /etc/apt/sources.list.d/yarn.list && \
    apt-get update --allow-releaseinfo-change

# ROS 2 key/source
RUN apt-get install -y --no-install-recommends curl gnupg lsb-release && \
    curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /etc/apt/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
      > /etc/apt/sources.list.d/ros2.list

RUN apt-get update --allow-releaseinfo-change && \
    apt-get install -y --no-install-recommends \
      libi2c-dev \
      gpsd-clients \
      rtklib \
      ros-humble-teleop-twist-joy \
      ros-humble-teleop-twist-keyboard \
      ros-humble-hardware-interface \
      ros-humble-pluginlib \
      ros-humble-rclcpp \
      ros-humble-rclcpp-lifecycle \
      ros-humble-ros2-controllers-test-nodes \
      ros-humble-controller-manager \
      ros-humble-joint-state-broadcaster \
      ros-humble-diff-drive-controller \
      ros-humble-ros2controlcli \
      ros-humble-robot-state-publisher \
      ros-humble-launch \
      ros-humble-launch-ros \
      ros-humble-xacro \
      ros-humble-sensor-msgs \
      ros-humble-nmea-navsat-driver \
      ros-humble-imu-tools \
      ros-humble-std-srvs \
      ros-humble-slam-toolbox \
      ros-humble-nav2-bringup \
      ros-humble-navigation2 \
      python3-serial \
      ros-humble-robot-localization \
      ros-humble-usb-cam \
      ros-humble-rqt \
      ros-humble-ros2-controllers \
      ros-humble-ntrip-client && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Use the source KumarRobotics ublox driver instead of the Humble apt package.
# The source ROS 2 branch exposes RTCM input; the Humble binary package in this
# image does not subscribe to /rtcm.
RUN git clone --branch ros2 https://github.com/KumarRobotics/ublox.git \
      /workspaces/isaac_ros-dev/src/box_bot/src/ublox

RUN pip3 install --upgrade Jetson.GPIO

WORKDIR /workspaces/isaac_ros-dev

RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

EXPOSE 8080
EXPOSE 11311

COPY 10_add_gpio_groups.sh /usr/local/bin/scripts/entrypoint_additions/
