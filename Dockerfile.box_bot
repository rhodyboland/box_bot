# Layer after isaac_ros.realsense, selected by the Isaac ROS CLI.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ROS and NVIDIA apt sources, CUDA, and RealSense are owned by the CLI layers.
RUN : "${ROS_DISTRO:?The Isaac ROS base must define ROS_DISTRO}" && \
    test "${ROS_DISTRO}" = lyrical && \
    apt-get update && apt-get install -y --no-install-recommends \
      libboost-system-dev libboost-thread-dev libcurl4-openssl-dev libi2c-dev libusb-1.0-0-dev \
      i2c-tools gpsd-clients rtklib python3-serial python3-pytest \
      ros-${ROS_DISTRO}-hardware-interface \
      ros-${ROS_DISTRO}-controller-manager \
      ros-${ROS_DISTRO}-ros2controlcli \
      ros-${ROS_DISTRO}-diff-drive-controller \
      ros-${ROS_DISTRO}-joint-state-broadcaster \
      ros-${ROS_DISTRO}-robot-state-publisher \
      ros-${ROS_DISTRO}-xacro \
      ros-${ROS_DISTRO}-teleop-twist-joy \
      ros-${ROS_DISTRO}-teleop-twist-keyboard \
      ros-${ROS_DISTRO}-robot-localization \
      ros-${ROS_DISTRO}-nav2-bringup \
      ros-${ROS_DISTRO}-navigation2 \
      ros-${ROS_DISTRO}-slam-toolbox \
      ros-${ROS_DISTRO}-imu-tools \
      ros-${ROS_DISTRO}-ntrip-client \
      ros-${ROS_DISTRO}-rtcm-msgs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install outside system site-packages on Noble (PEP 668).
ARG JETSON_GPIO_VERSION=2.1.13
RUN apt-get update && apt-get install -y --no-install-recommends python3-pip && \
    python3 -m pip install --no-cache-dir --no-deps \
      --target /opt/boxbot-python Jetson.GPIO==${JETSON_GPIO_VERSION} && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
ENV PYTHONPATH=/opt/boxbot-python

COPY 10_add_gpio_groups.sh /usr/local/bin/scripts/entrypoint_additions/
WORKDIR /workspaces/isaac_ros-dev
