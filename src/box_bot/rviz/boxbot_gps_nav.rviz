Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Satellite Aerial Map1
        - /RobotModel1
        - /TF1
        - /Navigation1
        - /Odometry1
        - /Sensors1
        - /Sensors1/Realsense PointCloud1
      Splitter Ratio: 0.5
    Tree Height: 760
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Nav2 Goal1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Blocks: 4
      Class: rviz_satellite/AerialMap
      Draw Behind: true
      ENU Aligned Reference Frame: map
      Enabled: true
      Name: Satellite Aerial Map
      Object URI: https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
      TF tolerance: 0.10000000149011612
      Timeout: 3
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /gps_rover/fix
      Use Local Map:
        Meter per Pixel (Zoom 0): 1
        Origin CRS: ""
        "Origin X ": 0
        "Origin Y ": 0
        Value: false
      Value: true
      Visualize in UTM Frame: false
      Zoom: 19
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 96
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Map Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: ""
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Mass Properties:
        Inertia: false
        Mass: false
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.6
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.38
          Binary representation: false
          Binary threshold: 100
          Class: rviz_default_plugins/Map
          Color Scheme: map
          Draw Behind: false
          Enabled: true
          Name: Global Costmap
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap_updates
          Use Timestamp: false
          Value: true
        - Alpha: 0.48
          Binary representation: false
          Binary threshold: 100
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Local Costmap
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap_updates
          Use Timestamp: false
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 20; 220; 100
          Enabled: true
          Name: Global Footprint
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/published_footprint
          Value: true
        - Alpha: 1
          Class: rviz_default_plugins/Polygon
          Color: 255; 180; 0
          Enabled: true
          Name: Local Footprint
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/published_footprint
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 60; 170; 255
          Enabled: true
          Head Diameter: 0.3
          Head Length: 0.2
          Length: 0.3
          Line Style: Lines
          Line Width: 0.08
          Name: Global Plan
          Offset:
            X: 0
            Y: 0
            Z: 0.04
          Pose Color: 60; 170; 255
          Pose Style: None
          Radius: 0.05
          Shaft Diameter: 0.1
          Shaft Length: 0.1
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /plan
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 90; 120
          Enabled: true
          Head Diameter: 0.25
          Head Length: 0.18
          Length: 0.25
          Line Style: Lines
          Line Width: 0.06
          Name: Controller Plan
          Offset:
            X: 0
            Y: 0
            Z: 0.08
          Pose Color: 255; 90; 120
          Pose Style: None
          Radius: 0.04
          Shaft Diameter: 0.08
          Shaft Length: 0.08
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /transformed_global_plan
          Value: true
        - Alpha: 1
          Axes Length: 0.6
          Axes Radius: 0.05
          Class: rviz_default_plugins/Pose
          Color: 255; 230; 0
          Enabled: true
          Head Length: 0.35
          Head Radius: 0.12
          Name: Goal Pose
          Shaft Length: 0.7
          Shaft Radius: 0.06
          Shape: Arrow
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /goal_pose
          Value: true
      Enabled: true
      Name: Navigation
    - Class: rviz_common/Group
      Displays:
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Color: 60; 220; 120
          Covariance:
            Orientation:
              Alpha: 0.25
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: true
            Position:
              Alpha: 0.2
              Color: 204; 51; 204
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 400
          Name: Global EKF Odom
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.5
            Axes Radius: 0.04
            Color: 60; 220; 120
            Head Length: 0.25
            Head Radius: 0.09
            Shaft Length: 0.45
            Shaft Radius: 0.04
            Value: Arrow
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odometry/global
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Color: 255; 160; 0
          Covariance:
            Orientation:
              Alpha: 0.2
              Color: 255; 255; 127
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.15
              Color: 255; 160; 0
              Scale: 1
              Value: false
            Value: false
          Enabled: true
          Keep: 400
          Name: Local EKF Odom
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.35
            Axes Radius: 0.025
            Color: 255; 160; 0
            Head Length: 0.18
            Head Radius: 0.07
            Shaft Length: 0.35
            Shaft Radius: 0.03
            Value: Arrow
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odometry/local
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Color: 80; 120; 255
          Covariance:
            Orientation:
              Alpha: 0.2
              Color: 80; 120; 255
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.25
              Color: 80; 120; 255
              Scale: 1
              Value: true
            Value: true
          Enabled: true
          Keep: 400
          Name: GPS Odom
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.35
            Axes Radius: 0.025
            Color: 80; 120; 255
            Head Length: 0.18
            Head Radius: 0.07
            Shaft Length: 0.35
            Shaft Radius: 0.03
            Value: Arrow
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /odometry/gps
          Value: true
        - Angle Tolerance: 0.1
          Class: rviz_default_plugins/Odometry
          Color: 180; 180; 180
          Covariance:
            Orientation:
              Alpha: 0.2
              Color: 180; 180; 180
              Color Style: Unique
              Frame: Local
              Offset: 1
              Scale: 1
              Value: false
            Position:
              Alpha: 0.1
              Color: 180; 180; 180
              Scale: 1
              Value: false
            Value: false
          Enabled: false
          Keep: 200
          Name: Wheel Odom
          Position Tolerance: 0.05
          Shape:
            Alpha: 1
            Axes Length: 0.25
            Axes Radius: 0.02
            Color: 180; 180; 180
            Head Length: 0.15
            Head Radius: 0.06
            Shaft Length: 0.28
            Shaft Radius: 0.025
            Value: Arrow
          Topic:
            Depth: 20
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /hoverboard_base_controller/odom
          Value: false
      Enabled: true
      Name: Odometry
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: rgb
          Class: rviz_default_plugins/PointCloud2
          Color: 255; 255; 255
          Color Transformer: RGB8
          Decay Time: 0.2
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 4096
          Min Color: 0; 0; 0
          Min Intensity: 0
          Name: Realsense PointCloud
          Position Transformer: XYZ
          Queue Size: 10
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.02
          Style: Points
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Value: /camera/depth/color/points
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Alpha: 1
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 10
            Min Value: -10
            Value: true
          Axis: Z
          Channel Name: intensity
          Class: rviz_default_plugins/LaserScan
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Max Intensity: 47
          Min Color: 0; 0; 0
          Min Intensity: 1
          Name: LaserScan
          Position Transformer: XYZ
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.05
          Style: Flat Squares
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /scan
          Use Fixed Frame: true
          Use rainbow: true
          Value: true
        - Acceleration properties:
            Acc. vector alpha: 1
            Acc. vector color: 255; 0; 0
            Acc. vector scale: 1
            Derotate acceleration: true
            Enable acceleration: false
          Axes properties:
            Axes scale: 0.45
            Enable axes: true
          Box properties:
            Box alpha: 0.35
            Box color: 255; 255; 255
            Enable box: false
            x_scale: 1
            y_scale: 1
            z_scale: 1
          Class: rviz_imu_plugin/Imu
          Enabled: true
          Name: Physical IMU
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /imu/data
          Value: true
          fixed_frame_orientation: true
        - Acceleration properties:
            Acc. vector alpha: 1
            Acc. vector color: 255; 0; 0
            Acc. vector scale: 1
            Derotate acceleration: true
            Enable acceleration: false
          Axes properties:
            Axes scale: 0.65
            Enable axes: true
          Box properties:
            Box alpha: 0.35
            Box color: 80; 120; 255
            Enable box: false
            x_scale: 1
            y_scale: 1
            z_scale: 1
          Class: rviz_imu_plugin/Imu
          Enabled: true
          Name: GPS Heading Corrected
          Topic:
            Depth: 5
            Durability Policy: Volatile
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /gps/heading_corrected
          Value: true
          fixed_frame_orientation: true
      Enabled: true
      Name: Sensors
  Enabled: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5707963705062866
      Class: rviz_default_plugins/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: false
  Selection:
    collapsed: true
  Tool Properties:
    collapsed: false
  Views:
    collapsed: false
  Width: 1500
  X: 60
  Y: 60
