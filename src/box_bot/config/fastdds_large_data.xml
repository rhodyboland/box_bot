<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Keep standard UDP interoperability and give local camera traffic a
       shared-memory segment large enough for multi-megabyte depth clouds. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>boxbot_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>boxbot_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="boxbot_large_data" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>boxbot_udp</transport_id>
        <transport_id>boxbot_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
